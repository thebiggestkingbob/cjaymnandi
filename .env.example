# Supabase project settings → API / API Keys. Do not use a service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key for the protected submission RPC. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Enable only after both migrations, connection tests and privacy review pass.
CONTACT_FORMS_ENABLED=false
CONTACT_PRIVACY_APPROVED=false
CONTACT_OPERATOR_NAME=

# Server-only transactional email; never use NEXT_PUBLIC_ prefixes.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Generate at least 32 random characters; keep stable (encrypts queued mail/tokens).
EMAIL_TOKEN_SECRET=
CRON_SECRET=
RESEND_DOMAIN_ID=
EMAIL_SENDING_ENABLED=false
EMAIL_SENDER_VERIFIED=false
EMAIL_DELIVERY_VERIFIED=false
CONTACT_DATABASE_VERIFIED=false
EMAIL_RETRY_SCHEDULE_VERIFIED=false
